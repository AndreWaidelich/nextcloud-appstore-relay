# Public base URL of this relay as Nextcloud sees it. REQUIRED.
# This is used to rewrite the "download" URLs in apps.json.
# Example: https://appstore-relay.example.org
RELAY_PUBLIC_URL=https://relay.example.org

# Upstream Nextcloud App Store API (default works for the official store).
RELAY_UPSTREAM=https://apps.nextcloud.com/api/v1

# Where to listen. Inside the container this is fine; map ports via compose.
RELAY_LISTEN=:8080

# On-disk cache directory (persisted via docker volume).
RELAY_CACHE_DIR=/var/cache/relay

# How long to consider apps.json / categories.json fresh before re-checking
# upstream (the relay still does conditional GETs using ETag/Last-Modified,
# so a refresh is cheap unless upstream actually changed).
RELAY_JSON_TTL=30m

# HTTP timeouts.
RELAY_UPSTREAM_TIMEOUT=60s
RELAY_TARBALL_TIMEOUT=10m

# Log level: debug | info | warn | error
RELAY_LOG_LEVEL=info
